# MongoDB connection string (MongoDB Atlas free tier works fine)
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/portfolio

# Port the API server listens on
PORT=5000

# Frontend origin allowed to call this API (set to your deployed frontend URL in production)
CLIENT_ORIGIN=http://localhost:5173

# --- Email notifications (Nodemailer) ---
# Gmail: turn on 2-Step Verification, then create an "App password" at
# https://myaccount.google.com/apppasswords — do NOT use your normal Gmail password.
EMAIL_SERVICE=gmail
EMAIL_USER=yogi2006kumar@gmail.com
EMAIL_PASS=your_16_char_app_password

# Where hire-me notifications are sent (defaults to EMAIL_USER if omitted)
NOTIFY_EMAIL=yogi2006kumar@gmail.com
